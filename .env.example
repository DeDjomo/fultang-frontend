# Configuration du Frontend Fultang

# URL de l'API Backend - Personnel Médical
# Par défaut: http://127.0.0.1:8000/api/
VITE_BACKEND_FULTANG_API_BASE_MEDICALSTAFF_URL=http://127.0.0.1:8000/api/

# URL de l'API Backend - Comptabilité
# Par défaut: http://127.0.0.1:8000/api/
VITE_BACKEND_FULTANG_API_BASE_ACCOUNTANT_URL=http://127.0.0.1:8000/api/

# URL de l'API Backend - Comptabilité Matière  
# Par défaut: http://127.0.0.1:8000/api/
VITE_BACKEND_COMPTABILITE_MATIERE_URL=http://127.0.0.1:8000/api/

# Note: Si vous utilisez un port différent pour le backend (ex: 9000),
# modifiez les URLs ci-dessus en conséquence.
# Exemple: http://127.0.0.1:9000/api/
